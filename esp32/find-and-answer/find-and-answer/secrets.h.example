#pragma once

// ---------------------------------------------------------------------------
// Copy this file to "secrets.h" and fill in your real values.
// secrets.h is gitignored so your credentials never get committed.
// ---------------------------------------------------------------------------

// ---- Wi-Fi mode ----
// Set to 1 to use your normal home Wi-Fi (WPA2-PSK) for testing.
// Set to 0 to use eduroam (WPA2-Enterprise) for the real deploy.
#define USE_HOME_WIFI   0

// ---- Home Wi-Fi (only used when USE_HOME_WIFI == 1) ----
#define WIFI_HOME_SSID      "your-home-ssid"
#define WIFI_HOME_PASSWORD  "your-home-password"

// ---- Wi-Fi (eduroam / WPA2-Enterprise) ----
#define WIFI_SSID       "eduroam"

// eduroam outer (anonymous) identity. Most institutions accept the full login.
// If UCS provides an anonymous identity (e.g. "anonymous@ucs.br"), use it here.
#define EAP_IDENTITY    "your-user@ucs.br"

// The actual login UCS gave you for eduroam (usually <user>@ucs.br).
#define EAP_USERNAME    "your-user@ucs.br"
#define EAP_PASSWORD    "your-eduroam-password"

// Optional: PEM root CA used to validate the eduroam RADIUS server.
// Leave as nullptr to skip server-cert validation (works, but less secure).
// Grab the CA from https://cat.eduroam.org/ (download the UCS profile and
// extract the CA certificate) and paste it between the R"EOF( ... )EOF".
#define EDUROAM_CA_PEM  nullptr
// Example when you DO have it:
// static const char EDUROAM_CA_PEM[] = R"EOF(
// -----BEGIN CERTIFICATE-----
// ...
// -----END CERTIFICATE-----
// )EOF";

// ---- UCS SOU API credentials (same as credentials.json) ----
#define UCS_USERNAME    "your-ucs-user"
#define UCS_PASSWORD    "your-ucs-password"

// ---- Discord webhook for logging (optional but handy for remote debugging) ----
// Set to "" to disable Discord logging.
#define DISCORD_WEBHOOK "https://discord.com/api/webhooks/xxxxx/yyyyy"
